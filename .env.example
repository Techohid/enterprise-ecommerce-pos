# Application
NEXT_PUBLIC_APP_NAME="NextCommerce & POS Enterprise"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/enterprise_ecommerce?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
AUTH_SECRET="enterprise_super_secret_jwt_key_at_least_32_characters_long_for_security"
AUTH_COOKIE_NAME="next_commerce_session"
AUTH_TOKEN_EXPIRY="7d"

# POS Configuration
POS_DEFAULT_WAREHOUSE_ID="wh_main_dhaka"
POS_OFFLINE_SYNC_ENABLED="true"

# Storage / Cloudflare R2 / S3 Compatible
STORAGE_PROVIDER="local" # 'local' | 's3' | 'r2'
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="ecommerce-assets"
S3_PUBLIC_DOMAIN="https://assets.example.com"

# Payment Gateways (Bangladesh & Global)
ENABLE_COD="true"
ENABLE_BKASH="true"
ENABLE_NAGAD="true"
ENABLE_SSLCOMMERZ="true"
ENABLE_STRIPE="false"

BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWD=""
SSLCOMMERZ_IS_SANDBOX="true"

# SEO Default Meta
SEO_DEFAULT_TITLE="Enterprise Multi-Vendor E-Commerce & POS"
SEO_DEFAULT_DESCRIPTION="Next-generation multi-vendor marketplace with unified real-time POS, warehouse inventory synchronization, and fast delivery."
SEO_CANONICAL_HOST="http://localhost:3000"
